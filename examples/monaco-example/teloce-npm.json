{
  "packages": [
    "monaco-editor"
  ],
  "bundling": {
    "mode": "always",
    "minify": true,
    "format": "esm",
    "target": "es2020"
  },
  "security": {
    "allow": {
      "monaco-editor": [
        "dynamic_function",
        "eval_usage",
        "dangerous_module"
      ]
    }
  }
}
