Use monaco-editor from teloce-npm

<script>
export default {
  data() {
    return { editor: null };
  },
  mounted() {
    const monaco = use('monaco-editor');
    this.editor = monaco.editor.create(document.getElementById('editor'), {
      value: '// Monaco is running inside a .vel component',
      language: 'javascript',
      theme: 'vs-dark',
      automaticLayout: true,
      minimap: { enabled: false }
    });
  },
  beforeUnmount() {
    this.editor?.dispose();
  }
};
</script>

<template>
  <main class="shell">
    <header>
      <span class="eyebrow">Teloce-NPM example</span>
      <h1>Monaco in a .vel component</h1>
      <p>JavaScript, CSS, fonts, and workers are bundled from npm.</p>
    </header>
    <section id="editor" aria-label="Monaco editor"></section>
  </main>
</template>

<style>
:global(body) { margin: 0; background: #10141c; color: #e7edf7; font-family: system-ui, sans-serif; }
.shell { min-height: 100vh; box-sizing: border-box; padding: 3rem; }
header { max-width: 900px; margin: 0 auto 1.5rem; }
.eyebrow { color: #72d6c9; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
h1 { margin: .5rem 0; font-size: clamp(2rem, 5vw, 4rem); }
p { color: #9da9ba; }
#editor { max-width: 1100px; height: 62vh; min-height: 360px; margin: 0 auto; border: 1px solid #2d3848; }
</style>
