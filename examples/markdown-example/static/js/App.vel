Use marked from teloce-npm
Use dompurify from teloce-npm

<script>
const SAMPLE = `# Hello from marked

Markdown rendered with **marked** and sanitized with **DOMPurify**.

- one
- two

<img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" onerror="document.title='XSS'"> <script>alert(1)<\/script>

\`inline code\` and a [link](https://example.com).`;

function pick(mod, key) {
  return (mod && mod[key]) || (mod && mod.default) || mod;
}

export default {
  data() { return { source: SAMPLE }; },
  computed: {
    html() {
      const marked = pick(use('marked'), 'marked');
      const purify = pick(use('dompurify'), 'default');
      const raw = typeof marked.parse === 'function' ? marked.parse(this.source) : marked(this.source);
      return purify.sanitize(raw);
    }
  }
};
</script>

<template>
  <main class="shell">
    <header>
      <span class="eyebrow">Teloce-NPM example</span>
      <h1>Markdown with two npm packages</h1>
      <p><code>marked</code> renders it, <code>dompurify</code> keeps it safe.</p>
    </header>
    <section class="grid">
      <div class="card">
        <h2>Markdown</h2>
        <textarea id="src" rows="14" :value="source" @input="source = $event.target.value"></textarea>
      </div>
      <div class="card">
        <h2>Preview (sanitized)</h2>
        <div id="preview" class="preview" v-html="html"></div>
      </div>
    </section>
  </main>
</template>

<style>
body { margin: 0; background: #10141c; color: #e7edf7; font-family: system-ui, sans-serif; }
.shell { min-height: 100vh; box-sizing: border-box; padding: 3rem; max-width: 1000px; margin: 0 auto; }
.eyebrow { color: #72d6c9; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
h1 { margin: .5rem 0; font-size: clamp(2rem, 5vw, 3.5rem); }
h2 { margin: 0 0 .75rem; font-size: 1rem; color: #72d6c9; font-weight: 600; }
p { color: #9da9ba; }
code, .mono { font-family: ui-monospace, monospace; }
.card { background: #171d28; border: 1px solid #2d3848; border-radius: 8px; padding: 1.25rem; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-top: 1rem; }
.row { display: flex; align-items: center; gap: .75rem; margin-top: .75rem; flex-wrap: wrap; }
label { color: #9da9ba; font-size: .85rem; }
textarea, input, select { background: #10141c; color: inherit; border: 1px solid #2d3848; border-radius: 6px; padding: .5rem; font: inherit; }
textarea { width: 100%; box-sizing: border-box; resize: vertical; font-family: ui-monospace, monospace; }
button { background: #72d6c9; color: #10141c; border: 0; border-radius: 6px; padding: .5rem .9rem; font-weight: 600; cursor: pointer; }
ul { margin: 0; padding-left: 1.1rem; }
li { margin: .25rem 0; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #2d3848; }
th { color: #72d6c9; font-weight: 600; }
.preview { line-height: 1.5; }
.preview a { color: #72d6c9; }
.preview code { background: #10141c; padding: .1rem .3rem; border-radius: 4px; }
</style>
