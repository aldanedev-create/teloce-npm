Use dayjs from teloce-npm

<script>
const iso = (d) => d.format('YYYY-MM-DD');

export default {
  data() {
    return { date: iso(use('dayjs')()), days: 30 };
  },
  computed: {
    d() { return use('dayjs')(this.date); },
    pretty() { return this.d.isValid() ? this.d.format('dddd, MMMM D, YYYY') : 'Invalid date'; },
    later() { return iso(this.d.add(Number(this.days) || 0, 'day')); },
    monthDays() { return this.d.daysInMonth(); },
    startOfWeek() { return iso(this.d.startOf('week')); },
    untilNewYear() { return this.d.endOf('year').diff(this.d, 'day'); },
    leap() { return this.d.year() % 4 === 0 && (this.d.year() % 100 !== 0 || this.d.year() % 400 === 0); }
  }
};
</script>

<template>
  <main class="shell">
    <header>
      <span class="eyebrow">Teloce-NPM example</span>
      <h1>Day.js in a .vel component</h1>
      <p>UMD package, loaded with <code>use('dayjs')</code>.</p>
    </header>
    <section class="card">
      <div class="row">
        <label for="date">Date</label>
        <input id="date" type="date" :value="date" @input="date = $event.target.value">
        <label for="days">Add days</label>
        <input id="days" type="number" :value="days" @input="days = $event.target.value" style="width:5rem">
      </div>
    </section>
    <section class="grid">
      <div class="card"><h2>format</h2><p id="pretty">{{ pretty }}</p></div>
      <div class="card"><h2>add</h2><p id="later">{{ later }}</p></div>
      <div class="card"><h2>startOf('week')</h2><p>{{ startOfWeek }}</p></div>
      <div class="card"><h2>daysInMonth</h2><p>{{ monthDays }}</p></div>
      <div class="card"><h2>diff to end of year</h2><p>{{ untilNewYear }} days</p></div>
      <div class="card"><h2>leap year?</h2><p>{{ leap ? 'yes' : 'no' }}</p></div>
    </section>
  </main>
</template>

<style>
body { margin: 0; background: #10141c; color: #e7edf7; font-family: system-ui, sans-serif; }
.shell { min-height: 100vh; box-sizing: border-box; padding: 3rem; max-width: 1000px; margin: 0 auto; }
