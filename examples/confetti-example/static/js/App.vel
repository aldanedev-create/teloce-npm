Use canvas-confetti from teloce-npm

<script>
function lib() {
  const mod = use('canvas-confetti');
  return mod.default || mod;
}

export default {
  methods: {
    burst() { lib()({ particleCount: 120, spread: 80, origin: { y: 0.6 } }); },
    cannons() {
      const confetti = lib();
      confetti({ particleCount: 80, angle: 60, spread: 55, origin: { x: 0 } });
      confetti({ particleCount: 80, angle: 120, spread: 55, origin: { x: 1 } });
    }
  }
};
</script>

<template>
  <main class="shell">
    <header>
      <span class="eyebrow">Teloce-NPM example</span>
      <h1>canvas-confetti in a .vel component</h1>
      <p>A function-style UMD package called through <code>use()</code>.</p>
    </header>
    <section class="card">
      <div class="row">
        <button id="burst" @click="burst">Burst</button>
        <button id="cannons" @click="cannons">Cannons</button>
      </div>
    </section>
  </main>
</template>

