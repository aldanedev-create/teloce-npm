Use three from teloce-npm

<script>
let frame = 0;
let renderer = null;

export default {
  data() { return { status: 'starting' }; },
  mounted() {
    const THREE = use('three');
    const host = document.getElementById('scene');
    const w = host.clientWidth, h = 360;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, w / h, 0.1, 100);
    camera.position.z = 3;
    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(w, h);
    host.appendChild(renderer.domElement);
    const cube = new THREE.Mesh(
      new THREE.BoxGeometry(1.4, 1.4, 1.4),
      new THREE.MeshNormalMaterial()
    );
    scene.add(cube);
    const tick = () => {
      cube.rotation.x += 0.01;
      cube.rotation.y += 0.015;
      renderer.render(scene, camera);
      frame = requestAnimationFrame(tick);
    };
    tick();
    this.status = 'running r' + THREE.REVISION;
  },
  beforeUnmount() {
    cancelAnimationFrame(frame);
    if (renderer) renderer.dispose();
    renderer = null;
  }
};
</script>

<template>
  <main class="shell">
    <header>
      <span class="eyebrow">Teloce-NPM example</span>
      <h1>Three.js in a .vel component</h1>
      <p>A WebGL scene from <code>use('three')</code>.</p>
    </header>
    <section class="card">
      <div id="scene"></div>
      <p id="status" class="mono">{{ status }}</p>
    </section>
  </main>
</template>

