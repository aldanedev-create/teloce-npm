// ============================================================
// loader.js — Teloce-NPM package loader
// Auto-generated by Teloce-NPM. DO NOT EDIT.
// ============================================================
//
// Loads all wrapped npm packages listed in manifest.json in
// dependency order, then dispatches the "teloce-npm-ready" event.
//
// Each wrapped package is a plain IIFE that attaches itself to
// window.<package_name>. We use dynamic import() so the browser
// executes them in the correct order and surfaces load errors.
//
(function() {
    "use strict";

    var MANIFEST_URL = "${manifest_url}";
    var BASE_PATH = "${base_path}";

    async function main() {
        console.log("[Teloce-NPM] Loading packages...");

        var manifest;
        try {
            var response = await fetch(MANIFEST_URL, { cache: "no-cache" });
            if (!response.ok) {
                throw new Error("HTTP " + response.status + " " + response.statusText);
            }
            manifest = await response.json();
        } catch (error) {
            console.error(
                "[Teloce-NPM] Could not load " + MANIFEST_URL + ". " +
                "Have you run `teloce-npm install`?"
            );
            console.error(error);
            return;
        }

        var packages = manifest.packages || {};
        var packageNames = Object.keys(packages);

        if (packageNames.length === 0) {
            console.log("[Teloce-NPM] No packages declared. Nothing to load.");
            window.dispatchEvent(new Event("teloce-npm-ready"));
            return;
        }

        console.log("[Teloce-NPM] Found " + packageNames.length + " package(s).");

        var loaded = new Set();
        var loading = new Set();

        async function loadPackage(name) {
            if (loaded.has(name)) return;

            if (loading.has(name)) {
                throw new Error(
                    "Circular dependency detected while loading package: " + name
                );
            }

            var info = packages[name];
            if (!info) {
                console.warn(
                    '[Teloce-NPM] Dependency "' + name + '" is referenced but not ' +
                    "present in the manifest. Skipping."
                );
                return;
            }

            loading.add(name);

            // Load dependencies first (depth-first)
            var deps = info.dependencies || {};
            for (var depName in deps) {
                if (Object.prototype.hasOwnProperty.call(deps, depName)) {
                    await loadPackage(depName);
                }
            }

            // Load this package
            var url = BASE_PATH + "/" + info.file;
            try {
                await import(url);
                loaded.add(name);
                console.log(
                    "[Teloce-NPM] Loaded " + name + "@" + info.version
                );
            } catch (error) {
                console.error(
                    "[Teloce-NPM] Failed to load " + name + " from " + url + ":",
                    error
                );
            }

            loading.delete(name);
        }

        // Load all packages
        for (var i = 0; i < packageNames.length; i++) {
            try {
                await loadPackage(packageNames[i]);
            } catch (error) {
                console.error("[Teloce-NPM] " + error.message);
            }
        }

        // Signal completion
        window.dispatchEvent(new Event("teloce-npm-ready"));
        console.log(
            "[Teloce-NPM] All packages loaded (" + loaded.size + "/" + packageNames.length + ")."
        );
    }

    main().catch(function(error) {
        console.error("[Teloce-NPM] Loader crashed:", error);
        window.dispatchEvent(new CustomEvent("teloce-npm-error", { detail: error }));
    });
})();